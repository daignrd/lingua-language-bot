# Bot identity & target language (REQUIRED)
BOT_NAME=Lingua
TARGET_LANGUAGE=Italian
USER_LOCATION=Rome
LEVEL_SYSTEM=CEFR B1

# Daily morning briefing schedule
# MORNING_HOUR is local hour (0-23) in your target timezone
# MORNING_TIMEZONE_OFFSET is your UTC offset in hours (e.g. 1 for CET, 9 for JST, -5 for EST)
MORNING_HOUR=9
MORNING_TIMEZONE_OFFSET=1

# News reading drill (/news command + morning briefing) — OPTIONAL
# An RSS 2.0 or Atom feed in your target language. Examples:
#   German:   https://www.tagesschau.de/index~rss2.xml
#   Italian:  https://www.ansa.it/sito/notizie/topnews/topnews_rss.xml
#   Japanese: https://www.nhk.or.jp/rss/news/cat0.xml
# Leave blank to disable the news features.
NEWS_RSS_URL=https://www.ansa.it/sito/notizie/topnews/topnews_rss.xml

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# LLM (OpenRouter for chat)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Voice — STT (Groq Whisper). TTS + live tutor use native Gemini (GEMINI_API_KEY above).
GROQ_API_KEY=your_groq_api_key_here

# Gemini voice settings (all optional — sensible defaults shown)
# Voices: Aoede, Puck, Charon, Kore, Fenrir, Orus
GEMINI_VOICE_NAME=Aoede
# Two-voice voices for /mock listening dialogues
GEMINI_VOICE_A=Charon
GEMINI_VOICE_B=Aoede
# Model overrides (optional)
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Live Tutor mini app (/tutor) — public URL of the deployed app (Railway domain, etc.)
# Leave blank to disable the /tutor command.
WEBAPP_URL=

# Database (Supabase + pgvector)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
